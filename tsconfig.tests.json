{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "types": ["vitest/globals", "chai", "node"],
        "paths": {
            "*": ["./node_modules/*", "./core/*"],
            // The alias `web/tsconfig.json` and `next.config.mjs` give the preview, and
            // `vitest.config.ts` gives the runner. A test that imports a v2 `lib/` module reaches
            // whatever that module imports, and without this those resolve to `any` — which does
            // not fail here, it just quietly stops checking them.
            "@core/*": ["./core/*"],
            "@band/*": ["./band/*"]
        }
    },
    "include": ["core/**/*.ts", "band/**/*.ts", "env.d.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
