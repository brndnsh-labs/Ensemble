{
    "permissions": {
        "allow": [
            "Bash(npm run typecheck)",
            "Bash(npm test)",
            "Bash(npm run lint:docs)",
            "Bash(npm run knip)",
            "Bash(npx vitest run *)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "npm run format",
                        "statusMessage": "Formatting...",
                        "timeout": 30
                    }
                ]
            }
        ],
        "Stop": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "output=$(npm run typecheck 2>&1) || echo \"$output\" >&2",
                        "statusMessage": "Type checking...",
                        "timeout": 60
                    }
                ]
            }
        ]
    }
}
