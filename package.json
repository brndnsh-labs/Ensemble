{
    "name": "ensemble",
    "description": "Ultra-lightweight Virtual Band & generative songwriting toolkit",
    "version": "1.2.2",
    "license": "AGPL-3.0-only",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "sideEffects": [
        "*.css"
    ],
    "scripts": {
        "dev": "npx vite",
        "format": "npx @biomejs/biome check --write .",
        "lint": "npx @biomejs/biome check .",
        "lint:docs": "node scripts/validate-docs.ts",
        "depcheck": "biome lint --only=suspicious/noImportCycles .",
        "knip": "knip",
        "jscpd": "jscpd public --no-tips",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
        "typecheck:tests": "tsc -p tsconfig.tests.json",
        "check-mutations": "node scripts/check-mutations.ts \"public/**/*.{ts,tsx}\"",
        "test": "npm run check-mutations && npm run lint && npm run lint:docs && npx vitest run --reporter=dot --silent=true",
        "test:browser": "npx vitest run --config vitest.browser.config.ts",
        "test:verbose": "npm run check-mutations && npm run lint && npx vitest run",
        "test:e2e": "npx playwright test",
        "test:coverage": "npx vitest run --coverage",
        "test:bench": "npx vitest run --config vitest.bench.config.ts tests/bench",
        "test:loop": "node scripts/test-loop.ts",
        "drums:report": "tsx scripts/evaluate-groove.ts",
        "ensemble:report": "tsx scripts/evaluate-ensemble.ts",
        "mix:report": "tsx scripts/mix-report.ts",
        "mix:diff": "tsx scripts/mix-diff.ts",
        "mix:analyze": "tsx scripts/mix-analyze.ts",
        "audition-link": "tsx scripts/audition-link.ts",
        "screenshots": "tsx scripts/capture-screenshots.ts",
        "size": "size-limit",
        "build:size": "npm run build && size-limit",
        "ci": "npm run typecheck && npm run depcheck && npm run knip && npm test && npm run build:size",
        "validate": "npm run format && npm run jscpd && npm run ci",
        "build": "npx vite build --mode test",
        "build:quiet": "npx vite build --mode test --logLevel warn",
        "build:e2e": "VITE_E2E_BRIDGE=1 npx vite build --mode production",
        "deploy:test": "./scripts/deploy.sh test",
        "deploy:prod": "./scripts/deploy.sh prod",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.10",
        "@playwright/test": "^1.59.1",
        "@preact/preset-vite": "^2.10.5",
        "@size-limit/preset-app": "^13.0.1",
        "@types/chai": "^5.2.3",
        "@vitest/browser": "^4.1.10",
        "@vitest/browser-playwright": "^4.1.10",
        "@vitest/coverage-v8": "^4.1.2",
        "cspell": "^10.0.0",
        "happy-dom": "^20.8.9",
        "husky": "^9.1.7",
        "jscpd": "^5.0.11",
        "knip": "^6.29.0",
        "lint-staged": "^17.0.4",
        "rollup-plugin-visualizer": "^7.0.1",
        "size-limit": "^13.0.1",
        "tsx": "^4.22.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.13",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.2",
        "workbox-core": "^7.4.1",
        "workbox-precaching": "^7.4.1"
    },
    "dependencies": {
        "@fontsource/geist-mono": "^5.2.8",
        "@fontsource/hanken-grotesk": "^5.2.8",
        "@preact/signals": "^2.9.0",
        "deepsignal": "^1.6.0",
        "preact": "^10.29.1",
        "workbox-cacheable-response": "^7.4.1",
        "workbox-routing": "^7.4.1",
        "workbox-strategies": "^7.4.1",
        "workbox-window": "^7.4.1"
    }
}
