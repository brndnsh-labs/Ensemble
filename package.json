{
  "name": "ensemble",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/budget.ts 10 node scripts/test.ts",
    "test:full": "ENSEMBLE_SEEDS=6 node scripts/budget.ts 60 node scripts/test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "ensemble": "node packages/cli/src/main.ts",
    "goldens": "node scripts/goldens.ts",
    "gate:1": "sh scripts/gate-1.sh",
    "gate:2": "sh scripts/gate-2.sh",
    "gate:3": "sh scripts/gate-3.sh",
    "gate:4": "sh scripts/gate-4.sh",
    "gate:5": "sh scripts/gate-5.sh",
    "score": "node scripts/budget.ts 120 node packages/cli/src/main.ts score --check",
    "packs:fetch": "node scripts/packs/fetch.ts",
    "packs:cut": "node scripts/packs/cut.ts",
    "audition": "node scripts/serve.ts",
    "render:audio": "node scripts/render-audio.ts",
    "app": "pnpm --filter @ensemble/app exec vite",
    "app:build": "pnpm --filter @ensemble/app build",
    "smoke": "node scripts/budget.ts 60 playwright test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
