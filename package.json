{
    "name": "ensemble",
    "description": "Ultra-lightweight Virtual Band & generative songwriting toolkit",
    "version": "1.2.2",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "dev": "npm run build:quiet && npx serve dist -p 5173",
        "format": "npx @biomejs/biome check --write .",
        "lint": "npx @biomejs/biome check .",
        "lint:docs": "node scripts/validate-docs.js",
        "depcheck": "depcruise public --config .dependency-cruiser.cjs",
        "knip": "knip",
        "jscpd": "jscpd public",
        "typecheck": "tsc -p jsconfig.json",
        "check-mutations": "node scripts/check-mutations.js public/*.js public/components/*.jsx",
        "test": "npm run check-mutations && npm run lint && npm run lint:docs && npx vitest run --reporter=dot --silent=true",
        "test:verbose": "npm run check-mutations && npm run lint && npx vitest run",
        "test:e2e": "npm run build:quiet && npx playwright test",
        "test:coverage": "npx vitest run --coverage",
        "test:bench": "npx vitest run --config vitest.bench.config.js tests/bench",
        "mix:report": "node scripts/mix-report.js",
        "size": "size-limit",
        "build:size": "npm run build && size-limit",
        "validate": "npm run typecheck && npm run knip && npm run jscpd && npm run format && npm test",
        "build": "./scripts/deploy-test.sh --dry-run",
        "build:quiet": "./scripts/deploy-test.sh --dry-run --quiet",
        "deploy:test": "./scripts/deploy-test.sh",
        "deploy:prod": "./scripts/deploy-prod.sh",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.8",
        "@playwright/test": "^1.58.2",
        "@preact/preset-vite": "^2.10.5",
        "@size-limit/preset-app": "^12.0.1",
        "@vitest/coverage-v8": "^4.1.0",
        "cspell": "^9.7.0",
        "dependency-cruiser": "^17.3.9",
        "esbuild": "^0.27.4",
        "happy-dom": "^20.8.9",
        "husky": "^9.1.7",
        "jscpd": "^4.0.8",
        "knip": "^6.0.1",
        "lint-staged": "^16.4.0",
        "size-limit": "^12.0.1",
        "typescript": "^5.9.3",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "@preact/signals": "^2.8.2",
        "deepsignal": "^1.6.0",
        "preact": "^10.29.0"
    }
}
