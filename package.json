{
    "name": "ensemble",
    "description": "Ultra-lightweight Virtual Band & generative songwriting toolkit",
    "version": "1.2.2",
    "license": "AGPL-3.0-only",
    "type": "module",
    "scripts": {
        "test": "npm run check-mutations && npm run lint && vitest run --reporter=dot --silent=true",
        "test:verbose": "npm run check-mutations && npm run lint && vitest run",
        "lint": "biome check .",
        "depcheck": "depcruise public --config .dependency-cruiser.cjs",
        "size": "size-limit",
        "build:size": "npm run build && size-limit",
        "knip": "knip",
        "format": "biome check --write .",
        "validate": "npm run format && npm test",
        "check-mutations": "grep -rnE \"(playback|chords|bass|soloist|harmony|groove|midi|vizState)\\.[a-zA-Z0-9]+ = \" public/components/ public/*.js | grep -v \"state/\" | grep -v \"reducer\" | grep -v \"@direct-mutation\" | grep -v \"@worker-mutation\" || true",
        "build": "./scripts/deploy-test.sh --dry-run",
        "build:quiet": "./scripts/deploy-test.sh --dry-run --quiet",
        "preview": "npx serve dist -p 5173",
        "test:e2e": "npm run build:quiet && playwright test",
        "test:coverage": "vitest run --coverage",
        "deploy:test": "./scripts/deploy-test.sh",
        "deploy:prod": "./scripts/deploy-prod.sh",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.7",
        "@playwright/test": "^1.58.2",
        "@preact/preset-vite": "^2.10.3",
        "@size-limit/preset-app": "^12.0.1",
        "@vitest/coverage-v8": "^4.1.0",
        "cspell": "^9.7.0",
        "dependency-cruiser": "^17.3.9",
        "esbuild": "^0.27.4",
        "happy-dom": "^20.8.4",
        "husky": "^9.1.7",
        "knip": "^5.86.0",
        "lint-staged": "^16.4.0",
        "size-limit": "^12.0.1",
        "vitest": "^4.1.0"
    },
    "dependencies": {
        "preact": "^10.29.0"
    }
}
