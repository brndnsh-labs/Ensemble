{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "*": ["node_modules/*", "public/*"]
        }
    },
    "include": [
        "public/**/*.js",
        "public/**/*.jsx",
        "public/**/*.ts",
        "public/**/*.tsx",
        "env.d.ts"
    ],
    "exclude": ["node_modules", "dist", "tests", "scripts"]
}
