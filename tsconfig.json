{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "strict": true,
        "erasableSyntaxOnly": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "paths": {
            "*": ["./node_modules/*", "./public/*"]
        }
    },
    "include": ["public/**/*.ts", "env.d.ts"],
    "exclude": ["node_modules", "dist", "tests", "scripts"]
}
