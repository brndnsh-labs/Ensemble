{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "*": ["node_modules/*", "public/*"]
        }
    },
    "include": ["public/**/*.ts", "public/**/*.tsx", "env.d.ts"],
    "exclude": ["node_modules", "dist", "tests", "scripts"]
}
