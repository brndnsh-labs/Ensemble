{
    // "DOM" is in `lib` for TYPES only: the shared `core/` codecs the Save endpoint bundles
    // (via web/lib/sync) reference Web Audio / DOM types in type positions. Nothing
    // here runs in a browser; `platform: 'node'` in build.mjs is what the runtime gets.
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "vitest.api.config.ts"],
    "exclude": ["node_modules", "dist"]
}
