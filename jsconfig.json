{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Node",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "*": ["node_modules/*", "public/*"]
        }
    },
    "include": ["public/**/*.js", "public/**/*.jsx", "env.d.ts"],
    "exclude": ["node_modules", "dist", "tests", "scripts"]
}
