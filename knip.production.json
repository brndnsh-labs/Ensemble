{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": ["scripts/**/*.ts!"],
            "project": [
                "public/**/*.{ts,tsx}!",
                "band/**/*.ts!",
                "scripts/**/*.ts!",
                "!band/**/*.test.ts!",
                "!band/test/**!"
            ]
        },
        "prototypes/v2": {
            "entry": ["app/**/{page,layout,not-found,error,manifest}.{ts,tsx}!", "scripts/*.mjs!"],
            "project": [
                "app/**/*.{ts,tsx}!",
                "lib/**/*.{ts,tsx}!",
                "scripts/*.mjs!",
                "!**/*.test.{ts,tsx}!",
                "!lib/**/test/**!"
            ]
        },
        "prototypes/v2-api": {
            "entry": ["src/server.ts!", "build.mjs!"],
            "project": ["src/**/*.ts!"]
        }
    },
    "ignoreExportsUsedInFile": true,
    "ignoreBinaries": ["ffmpeg"]
}
