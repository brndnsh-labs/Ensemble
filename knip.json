{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "public/main.ts",
        "public/sw.ts",
        "public/logic-worker.ts",
        "public/ui-types.ts",
        "public/ui-root.tsx",
        "public/visualizer-worker.ts",
        "scripts/*.js",
        "tests/scripts/*.js"
    ],
    "project": ["public/**/*.{js,jsx,ts,tsx}", "scripts/*.js", "tests/**/*.js"],
    "ignoreDependencies": ["esbuild"],
    "ignoreExportsUsedInFile": true,
    "ignore": ["public/engine/grooves/*.ts"]
}
