{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "band/index.ts",
                "band/**/*.test.ts",
                "scripts/**/*.ts",
                "tests/**/*.{test,spec}.ts",
                "tests/scripts/**/*.ts",
                "tests/utils/seeded-random.ts"
            ],
            "project": ["core/**/*.ts", "band/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
        },
        "web": {
            "entry": ["app/**/*.{ts,tsx}", "lib/**/*.ts", "scripts/*.mjs", "checks/**/*.ts"],
            "project": ["app/**/*.{ts,tsx}", "lib/**/*.ts", "scripts/*.mjs", "checks/**/*.ts"]
        },
        "api": {
            "entry": ["src/auth/index.ts", "test/**/*.test.ts"],
            "project": ["src/**/*.ts", "test/**/*.ts"]
        }
    },
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "ignoreBinaries": ["ffmpeg"]
}
