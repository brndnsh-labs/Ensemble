{
    "$schema": "https://unpkg.com/knip@5/schema.json",
    "entry": [
        "public/main.ts",
        "public/sw.ts",
        "public/logic-worker.ts",
        "public/ui-types.ts",
        "public/ui-root.tsx",
        "public/visualizer-worker.ts",
        "scripts/*.ts",
        "tests/scripts/*.ts"
    ],
    "project": ["public/**/*.{ts,tsx}", "scripts/*.ts", "tests/**/*.{ts,tsx}"],
    "ignoreDependencies": ["esbuild"],
    "ignoreExportsUsedInFile": true,
    "ignore": ["public/engine/grooves/*.ts"]
}
