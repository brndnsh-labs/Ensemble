+import fs from 'fs';
+
+function addProps(filePath) {
+    let content = fs.readFileSync(filePath, 'utf8');
+    
+    // Add /** @param {Object} props */ before export function ComponentName(props)
+    // or export function ComponentName()
+    
+    // Quick regex to find export function ...
+    // we need to be careful not to duplicate if it already exists
+    if (!content.includes('/** @param {Object} props */') && !content.includes('/**\n * @param {Object} props')) {
+        content = content.replace(/export function ([A-Za-z0-9_]+)\s*\((.*?)\)\s*\{/g, (match, name, args) => {
+            return `/**\n * @param {Object} props\n */\nexport function ${name}(${args}) {`;
+        });
+    }
+    
+    fs.writeFileSync(filePath, content, 'utf8');
+}
+
+const files = [
+  'public/components/NotificationLayer.jsx',
+  'public/components/PerformanceCanvas.jsx',
+  'public/components/PerformanceModal.jsx',
+  'public/components/PresetLibrary.jsx',
+  'public/components/PWAUpdateBanner.jsx',
+  'public/components/SectionCard.jsx',
+  'public/components/SequencerGrid.jsx',
+  'public/components/Settings.jsx',
+  'public/components/ShareModal.jsx',
+  'public/components/SoloistSmartTab.jsx',
+  'public/components/StyleSelector.jsx',
+  'public/components/SymbolMenu.jsx',
+  'public/components/Transport.jsx',
+  'public/components/UIControls.jsx',
+  'public/components/Visualizer.jsx'
+];
+
+files.forEach(addProps);
